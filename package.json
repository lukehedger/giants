{
  "name": "giants",
  "private": true,
  "workspaces": [
    "api",
    "bootstrap",
    "infra",
    "packages/*"
  ],
  "scripts": {
    "fmt": "biome check ./ --write",
    "test:unit": "POWERTOOLS_LOG_LEVEL=SILENT turbo test:unit",
    "types": "tsc --noEmit"
  },
  "packageManager": "bun@1.3.11",
  "catalog": {
    "@aws-lambda-powertools/logger": "2.36.0",
    "@aws-lambda-powertools/metrics": "2.36.0",
    "@aws-lambda-powertools/parameters": "2.36.0",
    "@aws-lambda-powertools/tracer": "2.36.0",
    "@aws-sdk/client-appconfigdata": "3.1169.0",
    "@aws-sdk/client-dynamodb": "3.1169.0",
    "@aws-sdk/client-secrets-manager": "3.1169.0",
    "@aws-sdk/lib-dynamodb": "3.1169.0",
    "@types/aws-lambda": "8.10.164",
    "aws-cdk": "2.1148.1",
    "aws-cdk-lib": "2.277.0",
    "aws-cdk-local": "3.1.0",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "turbo": "^2.11.11"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
